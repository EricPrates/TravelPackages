# Server
PORT=4567
NODE_ENV=development

# JWT Authentication
JWT_PRIVATE_KEY=sua_chave_privada_aqui
JWT_REFRESH_KEY=sua_chave_refresh_aqui

# Amadeus API (para busca de viagens)
API_KEY=sua_api_key_amadeus
API_SECRET=seu_api_secret_amadeus

# Google OAuth
GOOGLE_ID=seu_google_client_id
GOOGLE_SECRET=seu_google_client_secret
GOOGLE_REDIRECT_URI=minhaapp://auth
