{
  "info": {
    "name": "VendasViagens API - TravelPackages",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Create TravelPackage",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"agentId\": 1,\n  \"title\": \"Viagem Exemplo\",\n  \"origin\": \"GRU\",\n  \"destination\": \"LON\",\n  \"departureDate\": \"2025-12-01\",\n  \"returnDate\": \"2025-12-10\",\n  \"description\": \"Pacote demo\",\n  \"availableSlots\": 10,\n  \"numberOfTravelers\": 2\n}"
        },
        "url": { "raw": "{{baseUrl}}/travel-packages", "host": ["{{baseUrl}}"], "path": ["travel-packages"] }
      },
      "response": []
    },
    {
      "name": "Get Package (detail)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/travel-packages/{{packageId}}", "host": ["{{baseUrl}}"], "path": ["travel-packages", "{{packageId}}"] }
      },
      "response": []
    },
    {
      "name": "Get All Options (Amadeus)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/travel-packages/{{packageId}}/options", "host": ["{{baseUrl}}"], "path": ["travel-packages", "{{packageId}}", "options"] }
      },
      "response": []
    },
    {
      "name": "Get Options By Type (example: FLIGHT)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/travel-packages/{{packageId}}/options?type=FLIGHT",
          "host": ["{{baseUrl}}"],
          "path": ["travel-packages", "{{packageId}}", "options"],
          "query": [{ "key": "type", "value": "FLIGHT" }]
        }
      },
      "response": []
    },
    {
      "name": "Add Single Component (ex: FLIGHT)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"FLIGHT\",\n  \"component\": {\n    \"id\": \"AM123\",\n    \"name\": \"Voo Exemplo\",\n    \"moneyPrice\": 1200,\n    \"milesPrice\": 108000,\n    \"origin\": \"GRU\",\n    \"destination\": \"LHR\",\n    \"departureDate\": \"2025-12-01\"\n  }\n}"
        },
        "url": { "raw": "{{baseUrl}}/travel-packages/{{packageId}}/components", "host": ["{{baseUrl}}"], "path": ["travel-packages", "{{packageId}}", "components"] }
      },
      "response": []
    },
    {
      "name": "Add Components Bulk (optional)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"selectedFlight\": { \"id\": \"AM123\", \"moneyPrice\": 1200 },\n  \"selectedHotel\": { \"id\": \"H456\", \"moneyPrice\": 800 },\n  \"selectedActivities\": [ { \"id\": \"A789\", \"moneyPrice\": 50 } ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/travel-packages/{{packageId}}/components/bulk", "host": ["{{baseUrl}}"], "path": ["travel-packages", "{{packageId}}", "components", "bulk"] }
      },
      "response": []
    }
  ]
}